# The OpenRouter key below powers BOTH the Jev backend (route A) and the
# "any OpenRouter chat model" backend, including the live model list.

# ================= Jev =================
# Pick ONE of the two routes. If both keys are set, the native one wins.

# Route A -- via OpenRouter (easiest; billed to your OpenRouter account)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# optional, defaults shown:
# JEV_MODEL=~typesafe/jev-latest        # or typesafe/jev-1.14
# JEV_API_URL=https://openrouter.ai/api/v1/systemone
# OPENROUTER_SITE_URL=http://localhost:8787
# OPENROUTER_APP_TITLE=Tetris model players

# Route B -- native TypeSafe AI
# TYPESAFE_API_KEY=
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest

# ============== SAP-RPT-1 ==============
# Two routes. SAP_RPT_TOKEN wins if set; otherwise the AICORE_* values are used.
# An OpenRouter key does NOT work for either -- RPT-1 is not on OpenRouter.

# Route A -- the rpt.cloud.sap test API (simplest: one bearer token).
# Body is just {rows, index_column}; the target column is implied by the
# "[PREDICT]" cells, so no deployment id and no OAuth are needed.
SAP_RPT_TOKEN=
# SAP_RPT_URL=https://rpt.cloud.sap/api/predict
# feature importances (it returns them even unasked; 0 = do not request)
# SAP_RPT_EXPLANATIONS=4
#
# Measured limits of the free playground -- the proxy already respects these:
#   burst  ~5 requests per ~15s window -> 429 ERR_RATE_LIMIT_BURST, retry-after 3
#   quota  1000 requests per ~50 min   -> 3.0s per request sustained
# so calls are serialised and spaced; 3.5s was the first value that ran clean.
# SAP_RPT_MIN_INTERVAL_MS=3500
# SAP_RPT_TIMEOUT_MS=120000

# Route B -- SAP AI Core (needs a BTP subaccount + an RPT-1 deployment).
# All four values come from the AI Core service key, plus the deployment id.
# AICORE_AUTH_URL=https://<subdomain>.authentication.<region>.hana.ondemand.com
# AICORE_CLIENT_ID=
# AICORE_CLIENT_SECRET=
# AICORE_BASE_URL=https://api.ai.<region>.aws.ml.hana.ondemand.com
# RPT1_DEPLOYMENT_ID=
# AICORE_RESOURCE_GROUP=default

# Route C -- open weights (SAP/sap-rpt-1-oss, research / non-commercial) served
# locally behind the same /predict contract; no BTP account needed:
# AICORE_BASE_URL=http://localhost:9000
# RPT1_DEPLOYMENT_ID=local
# and leave the AICORE_* auth values unset.

# PORT=8787
# HOST=127.0.0.1   # loopback only; the proxy holds your keys, keep it off the network
